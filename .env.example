# ============================================================
# Postgraduate Information Assistant - Environment Variables
# Copy this file to `.env` and adjust the values.
# Never commit real secrets.
# ============================================================

# --- General ---
APP_NAME=Postgraduate Information Assistant
ENVIRONMENT=development

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgraduate_rag

# --- Qdrant ---
QDRANT_COLLECTION=postgraduate_documents

# --- Security (change in production!) ---
SECRET_KEY=change-me-to-a-long-random-string-in-production

# --- Frontend / Backend URLs ---
# Internal URL the Next.js server uses to proxy /api/* requests to the backend.
# Inside Docker this must be http://backend:8000 (compose service name).
INTERNAL_API_URL=http://backend:8000

# --- Storage ---
MAX_UPLOAD_SIZE_MB=20
CHAT_RATE_LIMIT_PER_MINUTE=30

# --- Initial admin (used by backend entrypoint to bootstrap the account) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_EMAIL=

# --- LLM defaults ---
# Optional OpenRouter key. Providers are normally configured in the
# Admin Dashboard (Admin -> LLM Providers).
OPENROUTER_API_KEY=
DEFAULT_LLM_MODEL=

# --- RAG defaults (overridable in Admin -> RAG Settings) ---
EMBEDDING_MODEL=hash-bge-m3-v1
RERANKER_MODEL=lexical
